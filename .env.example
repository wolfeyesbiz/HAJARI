# ---------- AttendEase environment template ----------
# Copy to .env and fill in. NEVER commit real secrets.

# Server
PORT=4000
NODE_ENV=production
# Set to 1 when served over HTTPS (required in production so the session cookie is Secure)
COOKIE_SECURE=0
TRUST_PROXY=0
SESSION_TTL_HOURS=12

# Database
# pglite = embedded PostgreSQL (WASM) with an on-disk data directory — zero external services.
# postgres = point at a managed PostgreSQL instance (recommended for real deployments).
DB_DRIVER=pglite
PGDATA_DIR=./data/pg
# DATABASE_URL=postgres://user:pass@host:5432/attendease?sslmode=require

# College identity used in SMS templates and reports
COLLEGE_NAME=Sunrise Institute of Technology
COLLEGE_SHORT=SIT
COLLEGE_ADDRESS=Ring Road, Pune, Maharashtra 411045

# ------------------------- SMS gateway -------------------------
# log  = no credentials: messages are queued and recorded as "not_sent" (never "sent")
# msg91 = live MSG91 flow API (real delivery). Requires an approved DLT template.
SMS_DRIVER=log
SMS_MAX_ATTEMPTS=5
SMS_RETRY_BASE_SECONDS=30
SMS_WORKER=1
SMS_WORKER_INTERVAL_MS=15000

# MSG91 (India). Get these from your MSG91 dashboard; keep them server-side only.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_FLOW_ID=
MSG91_ROUTE=4
MSG91_COUNTRY=91
MSG91_ENDPOINT=https://api.msg91.com/api/v5/flow
MSG91_DLT_TEMPLATE_ID=

# Shared secret for the gateway delivery-receipt (DLR) webhook: POST /api/sms/dlr?key=<secret>
SMS_DLR_SECRET=
